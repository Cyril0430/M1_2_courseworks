%%%%% 定理環境のパッケージ %%%%%
\usepackage{mdframed}

%%%%% 定義や定理環境の設定 %%%%%

\theoremstyle{definition}
\newmdtheoremenv{teigi}{定義}[section]
\newmdtheoremenv{teiri}[teigi]{定理}
\newmdtheoremenv{meidai}[teigi]{命題}
\newmdtheoremenv{kei}[teigi]{系}
\newmdtheoremenv{hodai}[teigi]{補題}
\newmdtheoremenv{chui}[teigi]{注意}
\newmdtheoremenv{mondai}[teigi]{問題}

\renewenvironment{definition}{
  \vspace{2.5mm}
  \begin{teigi}
}{
  \end{teigi}
  \vspace{2.5mm}
}
\renewenvironment{theorem}{
  \vspace{2.5mm}
  \begin{teiri}
}{
  \end{teiri}
  \vspace{2.5mm}
}
\newenvironment{proposition}{
  \vspace{2.5mm}
  \begin{meidai}
}{
  \end{meidai}
  \vspace{2.5mm}
}
\renewenvironment{corollary}{
  \vspace{2.5mm}
  \begin{kei}
}{
  \end{kei}
  \vspace{2.5mm}
}
\renewenvironment{lemma}{
  \vspace{2.5mm}
  \begin{hodai}
}{
  \end{hodai}
  \vspace{2.5mm}
}
\newenvironment{remark}{
  \vspace{2.5mm}
  \begin{chui}
}{
  \end{chui}
  \vspace{2.5mm}
}
\newenvironment{question}{
  \vspace{2.5mm}
  \begin{mondai}
}{
  \end{mondai}
  \vspace{2.5mm}
}



%%%%% TikZ関連パッケージ %%%%%
\usepackage{tikzpeople}
\usepackage{smartdiagram, sansmath, pgf-pie, wheelchart, fontawesome5}
\usepackage{adjustbox}

\UseTblrLibrary{booktabs}

\pdfstringdefDisableCommands{%  `%`を置いて改行コードを無効化するのを忘れずに
  \def\\{}% 
}

% itemizeやenumerate環境のitemsepを広くする
\setbeamertemplate{itemize/enumerate body begin}{\setlength{\itemsep}{1.5ex}}

% 定理環境に番号を付与する
\setbeamertemplate{theorems}[numbered]

\DeclareLanguageMapping{japanese}{english}
\DefineBibliographyStrings{japanese}{
  and = {・},
  andothers = {ほか}
}

\setbeamerfont{quotation}{shape=\upshape}
\DeclareDelimFormat{finalnamedelim}{%
  \iffieldequalstr{langid}{japanese}{・}{\addspace\&\space}%
}
\DeclareDelimFormat[textcite]{finalnamedelim}{%
  \iffieldequalstr{langid}{japanese}{・}{\addspace and\space}%
}

\usetikzlibrary{positioning, arrows.meta, calc, shapes.arrows, shapes.callouts, shapes.symbols, shapes.geometric}
\tcbuselibrary{skins, theorems, breakable}

%%%%% 枠を作る %%%%%

\newenvironment{purpose}[1]{
  \begin{tcolorbox}[
    enhanced,
    colframe=green!30!black,
    colback=green!30,
    title=#1,
    fonttitle=\bfseries\sffamily
  ]
}{
  \end{tcolorbox}
}

\newenvironment{conclusion}{
  \begin{tcolorbox}[
    enhanced,
    frame hidden,
    colback=blue!3,
    borderline west={2pt}{0pt}{blue}
  ]
}{
  \end{tcolorbox}
}

\newenvironment{bluebox}[1]{
    \begin{tcolorbox}[
        colframe=blue,
        colback=white,
        title=#1,
        fonttitle=\bfseries,
        breakable=true,
    ]
}{
    \end{tcolorbox}
}

\newcommand{\insertfullsection}{\insertsectionnumber. \insertsection}
\newcommand{\insertfullsubsection}{\insertsectionnumber.\insertsubsectionnumber. \insertsubsection}

%%%%% 数式等に関連 %%%%%

% \renewcommand{\bm}[1]{\symbfit{#1}}
\newcommand{\bm}[1]{\symbfit{#1}}
\renewcommand{\epsilon}{\varepsilon}
\newcommand{\abs}[1]{\left|#1\right|}
\newcommand{\norm}[1]{\left\lVert #1 \right\rVert}
\DeclareMathOperator*{\argmax}{argmax}

%%%%% ナンバリングの再定義 %%%%%
\setbeamertemplate{caption}[numbered]
\renewcommand{\thefigure}{\thesection.\arabic{figure}}  % captionのナンバリングに章番号を反映させる。

\numberwithin{equation}{section}